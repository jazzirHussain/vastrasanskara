# Read by apps/api/src/config.js (Task 5). Dev values shown.
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/vastrasanskara?replicaSet=rs0
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
SESSION_SECRET=change-me-dev-only-secret-at-least-32-chars

# AWS (production)
AWS_REGION=ap-south-1
FILES_BUCKET=vs-files-dev
BACKUPS_BUCKET=vs-backups-dev

# Mail: ses | file
MAIL_ADAPTER=file
MAIL_FROM=Vastrasanskara <no-reply@localhost>
MAIL_FILE_DIR=.dev-files/mail

# Storage: s3 | local
STORAGE_ADAPTER=local
STORAGE_LOCAL_DIR=.dev-files/storage
